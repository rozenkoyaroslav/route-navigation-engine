{
  "name": "route-navigation-engine",
  "version": "1.0.0",
  "description": "Turn-by-turn navigation core for a driver app: route matching, maneuver detection, sensor fusion, acceleration telemetry and map camera policy",
  "keywords": [
    "navigation",
    "mapbox",
    "polyline",
    "route-matching",
    "sensor-fusion",
    "telematics",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "tsx examples/drive.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Yaroslav Rozenko <313414934+rozenkoyaroslav@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozenkoyaroslav/route-navigation-engine.git"
  }
}
